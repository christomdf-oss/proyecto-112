{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Represents a student in the school.",
      "type": "object",
      "properties": {
        "matricula": {
          "type": "string",
          "description": "The student's unique ID."
        },
        "nombre": {
          "type": "string",
          "description": "The full name of the student."
        },
        "telefono_tutor": {
          "type": "string",
          "description": "The guardian's phone number."
        },
        "grupo": {
          "type": "string",
          "description": "The student's group or class."
        },
        "comunidad": {
          "type": "string",
          "description": "The student's community of origin."
        },
        "fingerprintRegistered": {
          "type": "boolean",
          "description": "Whether the student's fingerprint is registered."
        }
      },
      "required": ["matricula", "nombre", "telefono_tutor", "grupo", "comunidad"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Represents an attendance record for a student.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "description": "The ID of the student."
        },
        "studentName": {
          "type": "string",
          "description": "The name of the student (denormalized)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp of the attendance event."
        },
        "type": {
          "type": "string",
          "enum": ["entrada", "salida", "justificacion", "permiso"],
          "description": "The type of attendance event."
        },
        "isManual": {
          "type": "boolean",
          "description": "True if the record was added manually."
        },
        "reason": {
          "type": "string",
          "description": "The reason for a manual entry."
        }
      },
      "required": ["studentId", "studentName", "timestamp", "type"]
    },
    "notificationLog": {
      "title": "Notification Log",
      "description": "Represents a log of a sent notification.",
      "type": "object",
      "properties": {
        "studentName": {
          "type": "string",
          "description": "The name of the student for the notification."
        },
        "eventType": {
          "type": "string",
          "enum": ["entrada", "salida"],
          "description": "The type of event that triggered the notification."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the notification was sent."
        },
        "status": {
          "type": "string",
          "enum": ["success", "failed"],
          "description": "The status of the notification."
        },
        "reason": {
          "type": "string",
          "description": "The reason for a failed notification."
        }
      },
      "required": ["studentName", "eventType", "timestamp", "status"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/student"
      },
      "description": "Stores individual student profiles."
    },
    "/asistencias/{attendanceId}": {
      "schema": {
        "$ref": "#/entities/attendance"
      },
      "description": "Stores all attendance records for all students."
    },
    "/notificationLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/notificationLog"
      },
      "description": "Stores logs of sent WhatsApp notifications."
    }
  }
}
