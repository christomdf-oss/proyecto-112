rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read access to student and attendance data
    // In a real production app, this should be restricted to authenticated users
    // e.g., `allow read: if request.auth != null;`
    match /alumnos/{studentId} {
      allow read: if true;
      allow write: if false; // Write access should be more restrictive
    }

    match /asistencias/{asistenciaId} {
      allow read: if true;
      allow write: if false; // Write access should be more restrictive
    }
  }
}
